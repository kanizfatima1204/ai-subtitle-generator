# ─────────────────────────────────────────────────────────────────
# AI Service — Environment Configuration
# ─────────────────────────────────────────────────────────────────

# ── Whisper / WhisperX ──────────────────────────────────────────
# Device: "cpu" or "cuda" (use cuda if GPU is available)
WHISPER_DEVICE=cpu

# Compute type: "int8" (CPU), "float16" (GPU), "float32" (slower but accurate)
WHISPER_COMPUTE_TYPE=int8

# Default Whisper model size: tiny | base | small | medium | large-v2 | large-v3
# "medium" recommended for Bengali accuracy
WHISPER_DEFAULT_MODEL=medium

# ── LLM / AI Assistant ──────────────────────────────────────────
# Provider: "openai" | "ollama" | "groq" | "openrouter"
LLM_PROVIDER=openai

# API key (leave blank if using local Ollama)
LLM_API_KEY=YOUR_API_KEY_HERE

# Model name (OpenAI: gpt-4o-mini | Ollama: llama3.2 | Groq: llama-3.1-8b-instant)
LLM_MODEL=gpt-4o-mini

# Base URL (OpenAI default — change for Ollama: http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1

# LLM request timeout in seconds
LLM_TIMEOUT=90

# ── Server ──────────────────────────────────────────────────────
# Host and port for uvicorn
HOST=0.0.0.0
PORT=8001